__pycache__/
*.pyc
.venv/

# Benchmark data: fetched, not vendored (see benchmark/README.md)
benchmark/atlas_cohort/
benchmark/cb_labels.json
benchmark/cryptobench_atlas_result.json
benchmark/sifts.tsv
benchmark/atlas_pdb.txt
benchmark/cohort.json
benchmark/heldout_cohort/

# Fetched benchmark data, by pattern rather than by name. Listing cohort
# directories individually let two of them be committed by `git add -A`
# before this rule existed; a new cohort must not be able to repeat that.
benchmark/*_cohort/
benchmark/pdbcache/
benchmark/*.zip
benchmark/sifts.tsv
benchmark/atlas_pdb.txt
